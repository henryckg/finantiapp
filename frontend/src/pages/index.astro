---
import '../styles/global.css';
import RootRedirect from '../islands/RootRedirect';

const isDemo = (import.meta.env.PUBLIC_DEMO ?? 'true') !== 'false';
const destination = isDemo ? '/dashboard' : '/login';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Finanzas</title>
    <meta name="description" content="Finanzas personales: movimientos, cuentas, inversiones y objetivos." />
    <meta property="og:site_name" content="Finantiapp" />
    <meta property="og:title" content="Finantiapp" />
    <meta property="og:description" content="Finanzas personales: movimientos, cuentas, inversiones y objetivos." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    <meta property="og:image" content={new URL('/og.png', Astro.url.origin).toString()} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Finantiapp" />
    <meta name="twitter:description" content="Finanzas personales: movimientos, cuentas, inversiones y objetivos." />
    <meta name="twitter:image" content={new URL('/og.png', Astro.url.origin).toString()} />
  </head>
  <body class="min-h-dvh bg-bg-primary">
    <RootRedirect client:only="react" />
  </body>
</html>
