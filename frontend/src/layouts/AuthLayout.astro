---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"
    />
    <title>{title} · Finantiapp</title>
    <meta name="description" content="Inicia sesión en Finantiapp para gestionar tus movimientos, cuentas, inversiones y objetivos." />
    <meta name="theme-color" content="#0A0A0B" />
    <meta property="og:site_name" content="Finantiapp" />
    <meta property="og:title" content={`${title} · Finantiapp`} />
    <meta property="og:description" content="Inicia sesión en Finantiapp para gestionar tus movimientos, cuentas, inversiones y objetivos." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    <meta property="og:image" content={new URL('/og.png', Astro.url.origin).toString()} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Finantiapp`} />
    <meta name="twitter:description" content="Inicia sesión en Finantiapp para gestionar tus movimientos, cuentas, inversiones y objetivos." />
    <meta name="twitter:image" content={new URL('/og.png', Astro.url.origin).toString()} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Finantiapp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-dvh">
    <main class="mx-auto flex min-h-dvh w-full max-w-sm flex-col justify-center px-5 py-10">
      <slot />
    </main>
  </body>
</html>
